{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$ZELLIJ_PANE_ID\" ] || zellij pipe --name \"zellij-attention::working::$ZELLIJ_PANE_ID\"",
            "timeout": 7
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$ZELLIJ_PANE_ID\" ] || zellij pipe --name \"zellij-attention::working::$ZELLIJ_PANE_ID\"",
            "timeout": 7
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$ZELLIJ_PANE_ID\" ] || zellij pipe --name \"zellij-attention::working::$ZELLIJ_PANE_ID\"",
            "timeout": 7
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$ZELLIJ_PANE_ID\" ] || zellij pipe --name \"zellij-attention::waiting::$ZELLIJ_PANE_ID\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$ZELLIJ_PANE_ID\" ] || zellij pipe --name \"zellij-attention::waiting::$ZELLIJ_PANE_ID\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$ZELLIJ_PANE_ID\" ] || zellij pipe --name \"zellij-attention::working::$ZELLIJ_PANE_ID\"",
            "timeout": 7
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$ZELLIJ_PANE_ID\" ] || zellij pipe --name \"zellij-attention::completed::$ZELLIJ_PANE_ID\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
